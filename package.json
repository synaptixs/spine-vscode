{
  "name": "spine-vscode",
  "displayName": "Spine",
  "description": "Spine's Product Knowledge Graph in the editor: callers, blast radius, untested code and docs above your code, over MCP.",
  "version": "0.1.0",
  "publisher": "synaptixs",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synaptixs/spine-vscode.git"
  },
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Spine starts no process and makes no tool call. Trust the folder to use it.",
      "restrictedConfigurations": [
        "spine.serverPath",
        "spine.level",
        "spine.server",
        "spine.serverRepo"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "spine.doctor",
        "title": "Spine: Doctor (check the server)"
      },
      {
        "command": "spine.showCallers",
        "title": "Spine: Show callers",
        "enablement": "false"
      },
      {
        "command": "spine.openPlan",
        "title": "Spine: Open plan…"
      },
      {
        "command": "spine.approvePlan",
        "title": "Spine: Approve plan",
        "icon": "$(check)",
        "enablement": "spine.planCanDecide"
      },
      {
        "command": "spine.rejectPlan",
        "title": "Spine: Reject plan",
        "icon": "$(close)",
        "enablement": "spine.planCanDecide"
      },
      {
        "command": "spine.buildPlan",
        "title": "Spine: Build plan",
        "icon": "$(play)",
        "enablement": "spine.planCanBuild"
      },
      {
        "command": "spine.runs.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "spine.runs.cancel",
        "title": "Cancel build…",
        "icon": "$(debug-stop)"
      },
      {
        "command": "spine.runs.resume",
        "title": "Resume…",
        "icon": "$(debug-continue)"
      },
      {
        "command": "spine.runs.approve",
        "title": "Approve…",
        "icon": "$(check)"
      },
      {
        "command": "spine.runs.drop",
        "title": "Drop…",
        "icon": "$(close)"
      },
      {
        "command": "spine.runs.raiseCapAndResume",
        "title": "Raise cap and resume…",
        "icon": "$(debug-continue)"
      },
      {
        "command": "spine.runs.review",
        "title": "Review diff",
        "icon": "$(diff)"
      },
      {
        "command": "spine.runs.approveReview",
        "title": "Approve diff…",
        "icon": "$(check)"
      },
      {
        "command": "spine.runs.rejectReview",
        "title": "Reject diff…",
        "icon": "$(close)"
      },
      {
        "command": "spine.runs.openPatch",
        "title": "Open patch",
        "icon": "$(file-code)"
      },
      {
        "command": "spine.runs.fetch",
        "title": "Fetch into my checkout…",
        "icon": "$(repo-pull)"
      },
      {
        "command": "spine.review.approve",
        "title": "Spine: Approve diff…",
        "icon": "$(check)"
      },
      {
        "command": "spine.review.reject",
        "title": "Spine: Reject diff…",
        "icon": "$(close)"
      },
      {
        "command": "spine.runs.openWorktree",
        "title": "Open worktree",
        "icon": "$(folder-opened)"
      },
      {
        "command": "spine.runs.openPlan",
        "title": "Open plan",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "Spine",
      "properties": {
        "spine.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to an installed `orchestrator-mcp`. Empty (the default) starts Spine with the pinned `uvx` line, so only `uv` needs to be installed."
        },
        "spine.level": {
          "type": "string",
          "enum": [
            "pkg",
            "plan",
            "build"
          ],
          "default": "plan",
          "scope": "window",
          "markdownEnumDescriptions": [
            "The code and docs graph only: lenses, blast radius, reading a plan.",
            "Adds the build document and its approval.",
            "Adds the runs that write code and spend, with your own keys."
          ],
          "markdownDescription": "How much of Spine the local server shows, to this extension and to VS Code's chat (`ORCHESTRATOR_MCP_LEVEL`). Approving a plan needs `plan` or `build`."
        },
        "spine.server": {
          "type": "string",
          "default": "local",
          "scope": "window",
          "markdownDescription": "Where plans are reviewed: `local` (the default) starts Spine on this machine; the name of a server in VS Code's MCP configuration sends plan review there, and VS Code runs its sign-in. Lenses stay local. While a remote server is named, the extension offers VS Code no local Spine server."
        },
        "spine.serverRepo": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "With `spine.server` set: this repository's path **on that server**, one of the checkouts its admin listed. A shared server reads no path from your machine."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "spine.mcp",
        "label": "Spine"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "spine.approvePlan",
          "when": "resourceScheme == spine-plan",
          "group": "navigation@1"
        },
        {
          "command": "spine.rejectPlan",
          "when": "resourceScheme == spine-plan",
          "group": "navigation@2"
        },
        {
          "command": "spine.buildPlan",
          "when": "resourceScheme == spine-plan",
          "group": "navigation@3"
        },
        {
          "command": "spine.review.approve",
          "when": "resourceScheme =~ /^spine-(diff|patch)$/",
          "group": "navigation@1"
        },
        {
          "command": "spine.review.reject",
          "when": "resourceScheme =~ /^spine-(diff|patch)$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "spine.approvePlan",
          "when": "spine.planActive"
        },
        {
          "command": "spine.rejectPlan",
          "when": "spine.planActive"
        },
        {
          "command": "spine.buildPlan",
          "when": "spine.planActive"
        },
        {
          "command": "spine.runs.cancel",
          "when": "false"
        },
        {
          "command": "spine.runs.resume",
          "when": "false"
        },
        {
          "command": "spine.runs.raiseCapAndResume",
          "when": "false"
        },
        {
          "command": "spine.runs.approve",
          "when": "false"
        },
        {
          "command": "spine.runs.drop",
          "when": "false"
        },
        {
          "command": "spine.runs.openWorktree",
          "when": "false"
        },
        {
          "command": "spine.runs.openPlan",
          "when": "false"
        },
        {
          "command": "spine.runs.review",
          "when": "false"
        },
        {
          "command": "spine.runs.approveReview",
          "when": "false"
        },
        {
          "command": "spine.runs.rejectReview",
          "when": "false"
        },
        {
          "command": "spine.runs.openPatch",
          "when": "false"
        },
        {
          "command": "spine.runs.fetch",
          "when": "false"
        },
        {
          "command": "spine.review.approve",
          "when": "resourceScheme =~ /^spine-(diff|patch)$/"
        },
        {
          "command": "spine.review.reject",
          "when": "resourceScheme =~ /^spine-(diff|patch)$/"
        }
      ],
      "view/title": [
        {
          "command": "spine.runs.refresh",
          "when": "view == spine.runs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "spine.runs.review",
          "when": "view == spine.runs && viewItem =~ /:review:/",
          "group": "inline"
        },
        {
          "command": "spine.runs.cancel",
          "when": "view == spine.runs && viewItem =~ /:cancel:/",
          "group": "inline"
        },
        {
          "command": "spine.runs.resume",
          "when": "view == spine.runs && viewItem =~ /:resume:/",
          "group": "inline"
        },
        {
          "command": "spine.runs.raiseCapAndResume",
          "when": "view == spine.runs && viewItem =~ /:raiseCapAndResume:/",
          "group": "inline"
        },
        {
          "command": "spine.runs.approveReview",
          "when": "view == spine.runs && viewItem =~ /:review:/",
          "group": "1_decide"
        },
        {
          "command": "spine.runs.rejectReview",
          "when": "view == spine.runs && viewItem =~ /:review:/",
          "group": "1_decide"
        },
        {
          "command": "spine.runs.approve",
          "when": "view == spine.runs && viewItem =~ /:approve:/",
          "group": "1_decide"
        },
        {
          "command": "spine.runs.drop",
          "when": "view == spine.runs && viewItem =~ /:drop:/",
          "group": "1_decide"
        },
        {
          "command": "spine.runs.openPatch",
          "when": "view == spine.runs && viewItem =~ /:review:/",
          "group": "2_open"
        },
        {
          "command": "spine.runs.fetch",
          "when": "view == spine.runs && viewItem =~ /:fetch:/",
          "group": "inline"
        },
        {
          "command": "spine.runs.openWorktree",
          "when": "view == spine.runs && viewItem =~ /:openWorktree:/",
          "group": "2_open"
        },
        {
          "command": "spine.runs.openPlan",
          "when": "view == spine.runs && viewItem =~ /:openPlan:/",
          "group": "2_open"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spine",
          "title": "Spine",
          "icon": "media/spine.svg"
        }
      ]
    },
    "views": {
      "spine": [
        {
          "id": "spine.runs",
          "name": "Runs"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "npm run compile && mocha 'out/test/unit/**/*.test.js'",
    "test:contract": "npm run compile && mocha --timeout 600000 'out/test/contract/**/*.test.js'",
    "test:integration": "npm run compile && node out/test/integration/run.js",
    "package": "vsce package",
    "test:package": "npm run compile && node out/test/package/check.js",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0"
  }
}
